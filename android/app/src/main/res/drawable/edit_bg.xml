<!-- Rounded filled text field; red accent stroke while focused. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <solid android:color="@color/card" />
            <stroke android:width="1.5dp" android:color="@color/accent_bright" />
            <padding android:left="16dp" android:right="16dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <solid android:color="@color/card" />
            <stroke android:width="1dp" android:color="@color/card_stroke" />
            <padding android:left="16dp" android:right="16dp" />
        </shape>
    </item>
</selector>
