<Window x:Class="AirMic.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AirMic" Width="390" Height="490"
        ResizeMode="CanMinimize" WindowStartupLocation="CenterScreen"
        Icon="/AirMic;component/Assets/icon.ico"
        Background="#101013" Foreground="#F5F5F7"
        FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif" FontSize="13"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <SolidColorBrush x:Key="AccentBrush" Color="#D32F2F"/>
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#E53935"/>
        <SolidColorBrush x:Key="AccentPressedBrush" Color="#B71C1C"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#8E8E98"/>
        <SolidColorBrush x:Key="CardBackground" Color="#18181D"/>
        <SolidColorBrush x:Key="CardBorder" Color="#282832"/>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBackground}"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="15,12"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#787885"/>
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style TargetType="Hyperlink">
            <Setter Property="Foreground" Value="{StaticResource AccentHoverBrush}"/>
            <Setter Property="TextDecorations" Value="None"/>
        </Style>

        <Style x:Key="AccentButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Padding" Value="14,11"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}"
                                CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{StaticResource AccentHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{StaticResource AccentPressedBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="b" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="2,0,0,14">
            <TextBlock Text="AirMic" FontSize="26" FontWeight="Bold" Foreground="{StaticResource AccentHoverBrush}"/>
            <TextBlock Text="Microfono del telefono → microfono di sistema" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,2,0,0"/>
        </StackPanel>

        <!-- Audio Device Card -->
        <Border Grid.Row="1" Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="DISPOSITIVO AUDIO" Style="{StaticResource Caption}"/>
                <TextBlock x:Name="CableStatusText" TextWrapping="Wrap" LineHeight="18"/>
                <StackPanel x:Name="CableWarning" Visibility="Collapsed" Margin="0,7,0,0">
                    <TextBlock TextWrapping="Wrap" Foreground="#F5A623"
                               Text="Cavo virtuale non trovato. Installa VB-CABLE (gratuito) e riavvia AirMic:"/>
                    <TextBlock Margin="0,3,0,0">
                        <Hyperlink NavigateUri="https://vb-audio.com/Cable/" RequestNavigate="CableLink_RequestNavigate">
                            <Run Text="https://vb-audio.com/Cable/"/>
                        </Hyperlink>
                    </TextBlock>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Status Card -->
        <Border Grid.Row="2" Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="STATO" Style="{StaticResource Caption}"/>
                <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="StatusDot" Width="10" Height="10" Fill="{StaticResource MutedBrush}"
                             VerticalAlignment="Center" Margin="0,0,9,0"/>
                    <TextBlock x:Name="StatusHeadline" FontSize="15.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock x:Name="StatusDetail" Margin="0,6,0,0" Foreground="{StaticResource MutedBrush}" FontSize="12.5" TextWrapping="Wrap" LineHeight="17"/>
            </StackPanel>
        </Border>

        <!-- Connection / IP Card -->
        <Border Grid.Row="3" Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="CONNESSIONE DAL TELEFONO" Style="{StaticResource Caption}"/>
                <TextBlock x:Name="IpText" FontFamily="Consolas" FontSize="13" TextWrapping="Wrap" Foreground="#E2E2E8"/>
                <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" FontSize="11.5" Foreground="{StaticResource MutedBrush}"
                           Text="In Discord, WhatsApp e nei giochi seleziona il microfono «CABLE Output»." LineHeight="16"/>
            </StackPanel>
        </Border>

        <!-- Action Button -->
        <Button Grid.Row="4" x:Name="ToggleButton" Style="{StaticResource AccentButton}" Click="ToggleButton_Click"/>
    </Grid>
</Window>
